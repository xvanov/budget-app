activity.md

# App screenshots (may show real financial figures on screen)
/screenshots/

# Test run artifacts
test-results/

# Environment / secrets
.env
.env.*
*.env

# Machine-specific Docker Compose overrides
docker-compose.override.yml

# Editor / OS
.DS_Store
*.swp
.venv/
